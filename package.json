{
  "name": "nhl-fantasy-analyzer",
  "version": "0.1.0",
  "private": true,
  "description": "Opportunity-first NHL fantasy hockey analyzer (Next.js + Chakra + SQLite)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "ingest:all": "tsx scripts/ingest.ts --all",
    "ingest:season": "tsx scripts/ingest.ts",
    "ingest:yesterday": "tsx scripts/ingest.ts --current",
    "check:phase1": "tsx scripts/check-phase1.ts",
    "build:derived": "tsx scripts/build-derived.ts",
    "check:phase2": "tsx scripts/check-phase2.ts",
    "build:deployment": "tsx scripts/build-deployment.ts",
    "lines": "tsx scripts/show-lines.ts",
    "alerts": "tsx scripts/show-alerts.ts",
    "run:models": "tsx scripts/run-models.ts",
    "rankings": "tsx scripts/rankings.ts",
    "check:phase4": "tsx scripts/check-phase4.ts",
    "goalies": "tsx scripts/goalies.ts",
    "check:phase5": "tsx scripts/check-phase5.ts",
    "ingest:prospects": "tsx scripts/ingest-prospects.ts",
    "run:prospects": "tsx scripts/run-prospects.ts",
    "prospects": "tsx scripts/prospects.ts",
    "check:phase6": "tsx scripts/check-phase6.ts",
    "nightly": "tsx scripts/nightly.ts",
    "feed:rebuild": "tsx scripts/rebuild-feed.ts",
    "rebuild:all": "npm run ingest:all && npm run build:derived -- --rebuild && npm run build:deployment && npm run run:models"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.21.0",
    "@emotion/react": "^11.14.0",
    "better-sqlite3": "^11.10.0",
    "next": "^15.3.4",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "server-only": "^0.0.1",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.0"
  }
}
